# --- environment ---
.venv/
__pycache__/
*.py[cod]
# numba's on-disk cache (also lives in __pycache__)
*.nbi
*.nbc

# --- macOS ---
.DS_Store

# --- generated data -------------------------------------------------------
# Everything below is reproducible from the scripts; it is too big for git and
# would swamp the history.  Rebuild instead of restoring:
#   cusps/, data/     retired 2026-10-12: the data lives in OBD-core's shared store (~/obd-data)
#   analysis/         analyze_cusps.py --out analysis/
cusps/
analysis/
data/
cusps_n*.csv.gz

# analyze_cusps outputs copied to the top level for convenience.
# Leading slash = root only, so the curated copies in public/ are still tracked.
/per_n_summary.csv
/cusps_F3_negative.csv
/all_neighbors.csv

# --- plot outputs (large PNGs; regenerate with plotting/*.py) ---
plots/
#   lower_bound_proof_plots/   plotting/lower_bound/*.py (the L plots; default output dir)
lower_bound_proof_plots/
#   simplex_figures/          plotting/simplex/*.py (the simplex geometry figures)
simplex_figures/

# --- run logs (never tracked; regenerate the run instead) ---
*.log
# exit-code markers written by the batch scripts in runs/
*.done
simplifying_n*.csv
simplifying_n*_tier1.csv
